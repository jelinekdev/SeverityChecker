{
  "Scanner": {
    "ScanIntervalMinutes": 60,
    "ScanPaths": [],
    "ExcludedDirectories": [
      ".git",
      "node_modules",
      "bin",
      "obj",
      "target",
      "build",
      "dist",
      ".venv"
    ],
    "Npm": {
      "IncludeDevDependencies": true
    }
  },
  "Vulnerabilities": {
    "Provider": "Osv",
    "TimeoutSeconds": 30,
    "Cache": {
      "Enabled": true,
      "DurationMinutes": 60
    }
  },
  "Notifications": {
    "Enabled": false,
    "MinimumSeverity": "High",
    "Recipient": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true
    }
  }
}
